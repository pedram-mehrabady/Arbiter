{
  "name": "arbiter-pipeline",
  "version": "0.2.1",
  "description": "Deterministic multi-agent AI pipeline for structured feature delivery with ALC evidence generation",
  "keywords": [
    "ai",
    "pipeline",
    "agents",
    "llm",
    "automation",
    "evidence",
    "audit"
  ],
  "author": "Arbiter Pipeline Contributors",
  "license": "MIT",
  "bin": {
    "arbiter": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "agents/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "commander": "^12.1.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
